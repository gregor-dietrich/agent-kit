// devkit's profile, minus MD041: the agent definitions and four skills put
// prose, not a heading, after their frontmatter, CLAUDE.md is an import, and
// hooks/session-context.md is injected into every session as it stands.
// MD024 allows repeated headings (Added, Changed, Fixed) across distinct
// release sections in CHANGELOG.md while still catching sibling duplicates.
{
  "extends": ".devkit/markdown/markdownlint.jsonc",
  "MD041": false,
  "MD024": { "siblings_only": true }
}
